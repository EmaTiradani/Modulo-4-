# Copiar a .env y completar con valores reales. .env NUNCA se commitea (Principio IV).

# Connection string de PostgreSQL 15 (pooler en modo transacción si el
# proveedor lo requiere, p.ej. Supabase con conectividad IPv4-only)
DATABASE_URL="postgresql://usuario:password@host:6543/basededatos?pgbouncer=true"

# Connection string directa/pooler en modo sesión, usada por Prisma Migrate
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos"

# Secreto usado para firmar la cookie de sesion (JWT HS256). Minimo 32 caracteres aleatorios.
SESSION_SECRET="reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
