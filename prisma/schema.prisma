generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Dificultad {
  Facil
  Media
  Dificil
}

enum EstadoTarea {
  Pendiente
  Completada
}

enum TipoEvento {
  TareaCompletada
  HabitoCumplido
}

model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  xpAcumulada  Int      @default(0)
  createdAt    DateTime @default(now())

  tareas    Tarea[]
  habitos   Habito[]
  historial EventoHistorial[]
}

model Tarea {
  id          String      @id @default(uuid())
  usuarioId   String
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo      String
  descripcion String?
  dificultad  Dificultad
  estado      EstadoTarea @default(Pendiente)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  eventos EventoHistorial[]

  @@index([usuarioId])
}

model Habito {
  id         String     @id @default(uuid())
  usuarioId  String
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombre     String
  dificultad Dificultad
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  registros RegistroCumplimientoHabito[]
  eventos   EventoHistorial[]

  @@index([usuarioId])
}

model RegistroCumplimientoHabito {
  id        String   @id @default(uuid())
  habitoId  String
  habito    Habito   @relation(fields: [habitoId], references: [id], onDelete: Cascade)
  fecha     DateTime @db.Date
  createdAt DateTime @default(now())

  evento EventoHistorial?

  @@unique([habitoId, fecha])
}

model EventoHistorial {
  id                     String                      @id @default(uuid())
  usuarioId              String
  usuario                Usuario                     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo                   TipoEvento
  tareaId                String?
  tarea                  Tarea?                      @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  habitoId               String?
  habito                 Habito?                     @relation(fields: [habitoId], references: [id], onDelete: SetNull)
  registroCumplimientoId String?                     @unique
  registroCumplimiento   RegistroCumplimientoHabito? @relation(fields: [registroCumplimientoId], references: [id], onDelete: SetNull)
  fecha                  DateTime                    @default(now())
  xpObtenida             Int

  @@index([usuarioId, fecha(sort: Desc), id(sort: Desc)])
}
